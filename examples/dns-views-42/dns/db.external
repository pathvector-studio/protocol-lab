; app.lab. as seen from OUTSIDE (the external / default view).
; Everyone who is not an internal client gets the public address.
$TTL 300
app.lab.        IN  SOA ns.app.lab. admin.app.lab. (
                    1          ; serial
                    3600       ; refresh
                    900        ; retry
                    604800     ; expire
                    300 )      ; negative cache TTL
app.lab.        IN  NS  ns.app.lab.
ns.app.lab.     IN  A   203.0.113.2

; Outside answer: the public address (RFC 5737 documentation space).
app.lab.        60  IN  A   203.0.113.5
